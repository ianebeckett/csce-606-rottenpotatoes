<div id="<%= dom_id movie %>">
  <div>
    <strong>Title:</strong>
    <%= movie.title %>
  </div>

  <div>
    <strong>Rating:</strong>
    <%= movie.rating %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= movie.description %>
  </div>

  <div>
    <strong>Release date:</strong>
    <% if movie.release_date.present? %>
      <%= "#{movie.release_date.strftime('%B')} #{movie.release_date.day.ordinalize}, #{movie.release_date.strftime('%Y')}" %>
    <% end %>
  </div>

</div>
