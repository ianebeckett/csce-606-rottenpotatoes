<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table>
  <% excludes = %w[id description created_at updated_at] %>
  <thead>
    <tr>
      <% Movie.attribute_names.reject { |attr| excludes.include?(attr) }.each do |attr| %>
        <% is_current_sort = (session[:sort_by] == attr) %>
        <% current_dir = session[:direction] %>
        <% sort_class = is_current_sort ? "sorted-#{current_dir}" : "" %>
        <% next_direction = (is_current_sort && current_dir == "asc") ? "desc" : "asc" %>

        <th scope="col" class="<%= sort_class %>" aria-sort="<%= current_dir == 'asc' ? 'ascending' : 'descending' if is_current_sort %>">
          <%= link_to movies_path(sort_by: attr, direction: next_direction) do %>
            <%= attr.humanize %>
            <%= current_dir == "asc" ? " ▲" : " ▼" if is_current_sort %>
          <% end %>
        </th>
      <% end %>
      <th scope="col">Link</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <% Movie.attribute_names.reject { |attr| excludes.include?(attr) }.each do |attr| %>
          <% is_current_sort = (session[:sort_by] == attr) %>
          <% sort_class = is_current_sort ? "sorted-#{session[:direction]}" : "" %>
          <td class="<%= sort_class %>">
            <% value = movie.read_attribute(attr) %>
            <% if value.is_a?(ActiveSupport::TimeWithZone) %>
              <%= "#{value.strftime('%B')} #{value.day.ordinalize}, #{value.strftime('%Y')}" %>
            <% else %>
              <%= value %>
            <% end %>
          </td>
        <% end %>
        <td>
          <%= link_to "Show this movie", movie %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<tfoot>
  <%= link_to "New movie", new_movie_path %>
</tfoot>
